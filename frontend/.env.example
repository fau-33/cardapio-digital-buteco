# Frontend — Buteco do Papá
# Copie para ".env.local" e ajuste.

# URL da API (backend NestJS)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Habilita o botão "Entrar com Google" no login do admin.
# Só mude para "true" depois de configurar GOOGLE_CLIENT_ID/SECRET no backend.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
