# =============================================================================
# Backend — Buteco do Papá
# Copie para ".env" e preencha. NUNCA commite o .env real.
# =============================================================================

# Ambiente: "development" ou "production".
# Em production o token de recuperação de senha nunca é devolvido na API.
NODE_ENV=development
PORT=3000

# Banco Neon (obrigatório)
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Segredo do JWT (obrigatório). Gere um valor longo e aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Código exigido para cadastrar novos administradores (POST /auth/register).
# Deixe vazio para manter o cadastro de admins FECHADO.
ADMIN_REGISTRATION_SECRET=

# Admin inicial criado pelo seed (src/scripts/seed.mjs)
ADMIN_INITIAL_EMAIL=admin@buteco.com
ADMIN_INITIAL_NAME=Administrador
ADMIN_INITIAL_PASSWORD=

# Login com Google (opcional — enquanto vazio, /auth/google responde 503)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# E-mails autorizados a entrar como admin via Google (separados por vírgula)
ALLOWED_ADMIN_EMAILS=

# URL do frontend (redirecionamento pós-login Google)
FRONTEND_URL=http://localhost:3001
